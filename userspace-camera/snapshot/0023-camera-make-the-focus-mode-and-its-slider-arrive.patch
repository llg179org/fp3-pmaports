+
+    /// Puts the chosen mode on the camera, and keeps trying until it lands.
+    ///
+    /// The mode is chosen before there is a camera to tell: the setting is
+    /// read when the window is built, while the controls only exist once
+    /// PipeWire has the node configured. A single write at the wrong moment
+    /// goes nowhere and says nothing, which left the camera in its own default
+    /// - continuous hunting - while the menu showed the mode the user picked.
+    /// There is no way to ask the camera what mode it is in, so the only
+    /// honest fix is to keep asking until the controls are there to be written.
+    fn send_focus_mode(&self, attempt: u32) {
+        const RETRIES: u32 = 40;
+        const EVERY_MS: u64 = 250;
+
+        if self.request_autofocus(self.focus_mode().request()) {
+            /* A reconfigure loses a hand-set distance as well. */
+            if let Some(position) = self.imp().lens_position.get() {
+                let control = self
+                    .camera_controls()
+                    .into_iter()
+                    .find(|control| control.name == "LensPosition");
+
+                if let Some(control) = control {
+                    self.set_camera_control(&control, position);
+                }
+            }
+            return;
+        }
+
+        if attempt >= RETRIES {
+            log::warn!("Camera never offered its focus controls; giving up");
+            return;
+        }
+
+        glib::timeout_add_local_once(
+            std::time::Duration::from_millis(EVERY_MS),
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move || obj.send_focus_mode(attempt + 1)
+            ),
+        );
     }
 
