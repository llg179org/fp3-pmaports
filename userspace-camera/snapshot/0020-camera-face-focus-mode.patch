+// SPDX-License-Identifier: GPL-3.0-or-later
+//! A small, dependency-free face detector.
+//!
+//! This is the PICO method (Pixel Intensity Comparison-based Object detection,
+//! Markuš et al.): a cascade of shallow binary trees whose every node compares
+//! two pixels, so classifying a window costs only a handful of loads and no
+//! arithmetic on the image. It is the algorithm behind the browser face
+//! detectors (`pico.js`), and light enough to run a few times a second on this
+//! phone without a GPU or a heavy dependency.
+//!
+//! The trained cascade - `facefinder`, from the reference implementation - is
+//! embedded verbatim. Its binary layout, little-endian throughout, is: eight
+//! bytes skipped, then the tree depth and the number of trees as int32, then
+//! each tree as `(2^depth - 1)` four-byte nodes (four int8 pixel offsets), then
+//! `2^depth` float leaf predictions, then one float stage threshold used to
+//! stop early once a window cannot be a face.
+
+const CASCADE: &[u8] = include_bytes!("facefinder");
+
+/// A face found in a frame, in that frame's own pixels: the centre and the
+/// half-size (the detection window is square, `2*radius` on a side).
+#[derive(Debug, Clone, Copy)]
+pub struct Face {
+    pub cx: f32,
+    pub cy: f32,
+    pub radius: f32,
+    pub score: f32,
+}
+
+struct Tree {
+    /// Four int8 pixel offsets per internal node: (r1, c1, r2, c2).
+    nodes: Vec<[i8; 4]>,
+    /// Leaf predictions, one per possible path through the tree.
+    preds: Vec<f32>,
+    /// Accumulated-score floor below which the window is rejected.
+    threshold: f32,
+}
+
+pub struct Detector {
+    depth: u32,
+    trees: Vec<Tree>,
+}
+
+impl Detector {
+    /// Loads the embedded cascade. Panics only if that constant is corrupt,
+    /// which would be a build-time mistake, not a runtime condition.
+    pub fn new() -> Self {
+        Self::parse(CASCADE).expect("embedded facefinder cascade is malformed")
+    }
+
+    fn parse(data: &[u8]) -> Option<Self> {
+        let i32_at = |o: usize| -> Option<i32> {
+            data.get(o..o + 4)
+                .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        };
+        let f32_at = |o: usize| -> Option<f32> {
+            data.get(o..o + 4)
+                .map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+        };
+
+        let depth = i32_at(8)? as u32;
+        let ntrees = i32_at(12)? as usize;
+        let internal = (1usize << depth) - 1;
+        let leaves = 1usize << depth;
+
+        let mut trees = Vec::with_capacity(ntrees);
+        let mut o = 16;
+        for _ in 0..ntrees {
+            let mut nodes = Vec::with_capacity(internal);
+            for _ in 0..internal {
+                let b = data.get(o..o + 4)?;
+                nodes.push([b[0] as i8, b[1] as i8, b[2] as i8, b[3] as i8]);
+                o += 4;
+            }
+            let mut preds = Vec::with_capacity(leaves);
+            for _ in 0..leaves {
+                preds.push(f32_at(o)?);
+                o += 4;
+            }
+            let threshold = f32_at(o)?;
+            o += 4;
+            trees.push(Tree {
+                nodes,
+                preds,
+                threshold,
+            });
+        }
+
+        Some(Self { depth, trees })
+    }
+
+    /// Scores one square window centred at (`r`, `c`) of side `s`, all in
+    /// pixels. `None` means a tree rejected it; otherwise the higher the score
+    /// the more face-like. Pixels are 8-bit grey, row-major with `stride`.
+    fn classify(&self, px: &[u8], w: i32, h: i32, stride: i32, r: i32, c: i32, s: i32) -> Option<f32> {
+        let at = |rr: i32, cc: i32| -> u8 {
+            let rr = rr.clamp(0, h - 1);
+            let cc = cc.clamp(0, w - 1);
+            px[(rr * stride + cc) as usize]
+        };
+
+        let mut o = 0.0f32;
+        for tree in &self.trees {
+            let mut idx = 1usize;
+            for _ in 0..self.depth {
+                let n = tree.nodes[idx - 1];
+                let r1 = (256 * r + n[0] as i32 * s) >> 8;
+                let c1 = (256 * c + n[1] as i32 * s) >> 8;
+                let r2 = (256 * r + n[2] as i32 * s) >> 8;
+                let c2 = (256 * c + n[3] as i32 * s) >> 8;
+                let bit = usize::from(at(r1, c1) <= at(r2, c2));
+                idx = 2 * idx + bit;
+            }
+            o += tree.preds[idx - (1 << self.depth)];
+            if o <= tree.threshold {
+                return None;
+            }
+        }
+        Some(o)
+    }
+
+    /// Finds faces across scales and merges the overlapping hits into one per
+    /// face. `min_frac`/`max_frac` bound the face size as a fraction of the
+    /// shorter side; `q` is the minimum clustered score to believe.
+    pub fn detect(&self, px: &[u8], w: usize, h: usize, stride: usize) -> Vec<Face> {
+        let (w, h, stride) = (w as i32, h as i32, stride as i32);
+        let short = w.min(h) as f32;
+
+        // Sizes to look for, and how densely to slide the window.
+        let min_size = (short * MIN_FRACTION) as i32;
+        let max_size = (short * MAX_FRACTION) as i32;
+        let mut raw: Vec<Face> = Vec::new();
+
+        let mut s = min_size.max(24);
+        while s <= max_size {
+            let step = ((s as f32 * STRIDE_FRACTION) as i32).max(1);
+            let mut r = s / 2;
+            while r <= h - s / 2 {
+                let mut c = s / 2;
+                while c <= w - s / 2 {
+                    if let Some(score) = self.classify(px, w, h, stride, r, c, s) {
+                        if score > PER_WINDOW_SCORE {
+                            raw.push(Face {
+                                cx: c as f32,
+                                cy: r as f32,
+                                radius: s as f32 / 2.0,
+                                score,
+                            });
+                        }
+                    }
+                    c += step;
+                }
+                r += step;
+            }
+            s = ((s as f32 * SCALE_FACTOR) as i32).max(s + 1);
+        }
+
+        cluster(raw)
+    }
+}
+
+impl Default for Detector {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Bounds and tuning. These are the reference defaults; the honest ones will
+/// come from watching the detector run against real faces on the device.
+const MIN_FRACTION: f32 = 0.12;
+const MAX_FRACTION: f32 = 0.9;
+const STRIDE_FRACTION: f32 = 0.1;
+const SCALE_FACTOR: f32 = 1.1;
+/// A single window barely surviving the cascade is not yet a face; a real one
+/// is found many times over, and the cluster's summed score clears this.
+const PER_WINDOW_SCORE: f32 = 0.0;
+const CLUSTER_SCORE: f32 = 12.0;
+const CLUSTER_OVERLAP: f32 = 0.2;
+
+/// Merges detections of the same face (their windows overlap) into one, summing
+/// their scores so a face seen at many positions and scales outweighs a lone
+/// false positive, and drops clusters that never add up to a believable score.
+fn cluster(mut dets: Vec<Face>) -> Vec<Face> {
+    dets.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal));
+
+    let mut used = vec![false; dets.len()];
+    let mut out = Vec::new();
+
+    for i in 0..dets.len() {
+        if used[i] {
+            continue;
+        }
+        let mut sx = 0.0;
+        let mut sy = 0.0;
+        let mut sr = 0.0;
+        let mut ss = 0.0;
+        for j in i..dets.len() {
+            if used[j] || !overlap(&dets[i], &dets[j]) {
+                continue;
+            }
+            used[j] = true;
+            let wgt = dets[j].score.max(0.0);
+            sx += dets[j].cx * wgt;
+            sy += dets[j].cy * wgt;
+            sr += dets[j].radius * wgt;
+            ss += wgt;
+        }
+        if ss >= CLUSTER_SCORE {
+            out.push(Face {
+                cx: sx / ss,
+                cy: sy / ss,
+                radius: sr / ss,
+                score: ss,
+            });
+        }
+    }
+
+    out
+}
+
+/// Whether two detection windows are close enough to be the same face, by the
+/// overlap of the discs their centre and radius describe.
+fn overlap(a: &Face, b: &Face) -> bool {
+    let dx = a.cx - b.cx;
+    let dy = a.cy - b.cy;
+    let dist = (dx * dx + dy * dy).sqrt();
+    dist <= (a.radius + b.radius) * (1.0 - CLUSTER_OVERLAP)
+}
