+// SPDX-License-Identifier: GPL-3.0-or-later
+//! A GStreamer element that finds a face in each frame and announces where.
+//!
+//! Built exactly like the QR-code detector next to it - an in-place video
+//! filter that hands the grey plane to a worker thread and posts a message
+//! with the result - but running the [`crate::pico`] face detector. The message
+//! carries the face's centre and radius in the frame's own pixels, plus the
+//! frame size, so the viewfinder can put the autofocus window on the face and
+//! draw a box around it.
+
+use std::sync::LazyLock;
+use std::time::Duration;
+
+use gst_video::{prelude::*, video_frame::VideoFrameRef};
+use gtk::glib;
+
+pub static CAT: LazyLock<gst::DebugCategory> = LazyLock::new(|| {
+    gst::DebugCategory::new(
+        "face-detector",
+        gst::DebugColorFlags::empty(),
+        Some("Face detector"),
+    )
+});
+
+const DETECTOR_COOL_DOWN: Duration = Duration::from_millis(150);
+const DETECTOR_CAPS: &[gst_video::VideoFormat] = &[
+    gst_video::VideoFormat::Gray8,
+    gst_video::VideoFormat::I420,
+    gst_video::VideoFormat::Yv12,
+    gst_video::VideoFormat::Nv12,
+    gst_video::VideoFormat::Nv21,
+    gst_video::VideoFormat::Y41b,
+    gst_video::VideoFormat::Y42b,
+    gst_video::VideoFormat::Yuv9,
+    gst_video::VideoFormat::Yvu9,
+];
+
+mod imp {
+    use std::sync::{Mutex, OnceLock};
+
+    use gst::{BufferRef, subclass::prelude::*};
+    use gst_video::subclass::prelude::*;
+
+    use super::*;
+
+    pub struct FaceDetector {
+        pub last_run_t: Mutex<Option<std::time::Instant>>,
+        pub thread_pool: OnceLock<glib::ThreadPool>,
+        pub detector: LazyLock<crate::pico::Detector>,
+    }
+
+    impl Default for FaceDetector {
+        fn default() -> Self {
+            Self {
+                last_run_t: Mutex::new(None),
+                thread_pool: OnceLock::new(),
+                detector: LazyLock::new(crate::pico::Detector::new),
+            }
+        }
+    }
+
+    #[glib::object_subclass]
+    impl ObjectSubclass for FaceDetector {
+        const NAME: &'static str = "ApertureFaceDetector";
+        type Type = super::FaceDetector;
+        type ParentType = gst_video::VideoFilter;
+    }
+
+    impl ObjectImpl for FaceDetector {}
+    impl GstObjectImpl for FaceDetector {}
+
+    impl ElementImpl for FaceDetector {
+        fn metadata() -> Option<&'static gst::subclass::ElementMetadata> {
+            static ELEMENT_METADATA: LazyLock<gst::subclass::ElementMetadata> =
+                LazyLock::new(|| {
+                    gst::subclass::ElementMetadata::new(
+                        "Face detector",
+                        "Filter/Video",
+                        "Finds a face and reports where it is",
+                        "FP3 camera work",
+                    )
+                });
+
+            Some(&*ELEMENT_METADATA)
+        }
+
+        fn pad_templates() -> &'static [gst::PadTemplate] {
+            static PAD_TEMPLATES: LazyLock<Vec<gst::PadTemplate>> = LazyLock::new(|| {
+                let caps = gst_video::video_make_raw_caps(DETECTOR_CAPS)
+                    .any_features()
+                    .build();
+
+                vec![
+                    gst::PadTemplate::new(
+                        "src",
+                        gst::PadDirection::Src,
+                        gst::PadPresence::Always,
+                        &caps,
+                    )
+                    .unwrap(),
+                    gst::PadTemplate::new(
+                        "sink",
+                        gst::PadDirection::Sink,
+                        gst::PadPresence::Always,
+                        &caps,
+                    )
+                    .unwrap(),
+                ]
+            });
+
+            PAD_TEMPLATES.as_ref()
+        }
+    }
+
+    impl BaseTransformImpl for FaceDetector {
+        const MODE: gst_base::subclass::BaseTransformMode =
+            gst_base::subclass::BaseTransformMode::AlwaysInPlace;
+        const PASSTHROUGH_ON_SAME_CAPS: bool = true;
+        const TRANSFORM_IP_ON_PASSTHROUGH: bool = true;
+    }
+
+    impl VideoFilterImpl for FaceDetector {
+        fn transform_frame_ip_passthrough(
+            &self,
+            frame: &VideoFrameRef<&BufferRef>,
+        ) -> Result<gst::FlowSuccess, gst::FlowError> {
+            let now = std::time::Instant::now();
+
+            // A face does not move fast enough to be worth chasing every frame,
+            // and the detector is not free; leave a gap between runs.
+            if self
+                .last_run_t
+                .lock()
+                .unwrap()
+                .is_some_and(|t| (now - t) < DETECTOR_COOL_DOWN)
+            {
+                return Ok(gst::FlowSuccess::Ok);
+            }
+
+            let thread_pool = self
+                .thread_pool
+                .get_or_init(|| glib::ThreadPool::exclusive(1).unwrap());
+
+            if thread_pool.unprocessed() != 0 {
+                // The previous frame is still being searched; skip this one.
+                return Ok(gst::FlowSuccess::Ok);
+            }
+
+            // Every format above starts with an 8-bit luma plane, which is all
+            // the detector reads; the chroma planes are ignored.
+            let data = frame.comp_data(0).unwrap().to_vec();
+            let width = frame.width() as usize;
+            let height = frame.height() as usize;
+            let stride = frame.comp_stride(0) as usize;
+
+            let res = thread_pool.push(glib::clone!(
+                #[weak(rename_to = detector)]
+                self,
+                move || {
+                    detector.last_run_t.lock().unwrap().replace(now);
+
+                    let faces =
+                        detector.detector.detect(&data, width, height, stride);
+
+                    // The biggest face wins: the subject is the one nearest the
+                    // camera, and a bystander in the background should not steal
+                    // the focus.
+                    let Some(face) = faces
+                        .into_iter()
+                        .max_by(|a, b| a.radius.partial_cmp(&b.radius).unwrap())
+                    else {
+                        return;
+                    };
+
+                    let structure = gst::Structure::builder("face")
+                        .field("cx", face.cx as f64)
+                        .field("cy", face.cy as f64)
+                        .field("radius", face.radius as f64)
+                        .field("frame-width", width as i32)
+                        .field("frame-height", height as i32)
+                        .build();
+                    let msg = gst::message::Element::builder(structure)
+                        .src(&*detector.obj())
+                        .build();
+                    detector.post_message(msg);
+
+                    gst::trace!(
+                        CAT,
+                        "Face search took {}ms",
+                        now.elapsed().as_millis()
+                    );
+                }
+            ));
+            if let Err(err) = res {
+                log::error!("Could not spawn face-detection thread: {err}");
+            }
+
+            Ok(gst::FlowSuccess::Ok)
+        }
+    }
+}
+
+glib::wrapper! {
+    pub struct FaceDetector(ObjectSubclass<imp::FaceDetector>)
+        @extends gst::Object, gst::Element, gst_base::BaseTransform, gst_video::VideoFilter;
+}
+
+impl FaceDetector {
+    pub fn new() -> Self {
+        glib::Object::new()
+    }
+}
+
+impl Default for FaceDetector {
+    fn default() -> Self {
+        Self::new()
+    }
+}
