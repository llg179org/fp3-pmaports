+    /// Applies the current focus mode: switches face detection on for Face and
+    /// off otherwise, clearing the box when it is off, and keeps the camera on
+    /// its own autofocus while a face is being tracked.
+    pub fn apply_focus_mode(&self) {
+        let imp = self.imp();
+        let mode = imp.settings().string("focus-mode");
+
+        imp.viewfinder.set_detect_faces(mode == "face");
+        if mode == "face" {
+            // The box marks the face; the focus itself is still the continuous
+            // whole-frame autofocus, since windowing it onto the face needs a
+            // control the pipeline cannot yet carry.
+            imp.viewfinder.set_autofocus(true);
+        } else {
+            imp.guidelines.set_face(None);
+        }
+    }
+
     pub fn is_recording_active(&self) -> bool {
         self.imp().viewfinder.is_recording()
     }
