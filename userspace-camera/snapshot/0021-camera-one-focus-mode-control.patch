 use std::process::Command;
 use std::process::Stdio;
 
+/// How the camera is to focus, as the user chose it.
+///
+/// One setting rather than a switch and a mode that could disagree: each value
+/// is a different answer to "who decides when the lens moves, and on what".
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum FocusMode {
+    /// The camera keeps the whole picture in focus by itself.
+    #[default]
+    Continuous,
+    /// The camera focuses by itself, following a face it has found.
+    Face,
+    /// The camera does not hunt; a tap focuses and takes the picture.
+    Tap,
+    /// The camera does nothing. The lens stays where it is put, and the focus
+    /// distance is the user's to set.
+    Off,
+}
+
+impl FocusMode {
+    /// The value stored in the setting, and back again. An unknown string is
+    /// the default rather than an error: the setting outlives this list.
+    pub fn from_setting(value: &str) -> Self {
+        match value {
+            "face" => Self::Face,
+            "tap" => Self::Tap,
+            "off" => Self::Off,
+            _ => Self::Continuous,
+        }
+    }
+
+    pub fn as_setting(self) -> &'static str {
+        match self {
+            Self::Continuous => "continuous",
+            Self::Face => "face",
+            Self::Tap => "tap",
+            Self::Off => "off",
+        }
+    }
+
+    /// Whether the camera keeps itself in focus without being asked. Where
+    /// this is false, something has to focus before a picture is taken.
+    pub fn is_automatic(self) -> bool {
+        matches!(self, Self::Continuous | Self::Face)
+    }
+
+    /// Whether a tap on the viewfinder means "focus and shoot".
+    pub fn taps_shoot(self) -> bool {
+        matches!(self, Self::Tap)
+    }
+
+    /// What to ask the camera for to be in this mode.
+    pub fn request(self) -> AfRequest {
+        match self {
+            /* Face detection is drawn by the application; the camera itself
+             * is doing the same continuous whole-frame focus either way. */
+            Self::Continuous | Self::Face => AfRequest::Continuous,
+            Self::Tap => AfRequest::OnDemand,
+            Self::Off => AfRequest::Manual,
+        }
+    }
+}
+
 /// What to do with a camera's autofocus.
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub enum AfRequest {
@@ -28,6 +90,9 @@
     OnDemand,
     /// Focus once, now.
     Trigger,
+    /// Do not focus at all. The lens stays wherever it was left, and only a
+    /// lens position the user dials in moves it.
+    Manual,
 }
 
 impl AfRequest {
@@ -37,14 +102,28 @@
     /// property id to write and the value's meaning come from the camera
     /// itself, so nothing here has to agree with a copy of libcamera's
     /// headers.
+    /// The metering rides along with the mode because the two answer one
+    /// question together: whether the camera is judging the whole picture or
+    /// the middle of it. Focusing on demand is aimed - the user pointed the
+    /// phone and asked - so it meters the middle, where a whole-frame score
+    /// would be diluted by everything behind the subject that never sharpens.
+    /// Focusing continuously has nothing to aim at and keeps the whole frame.
     fn wanted(self) -> &'static [(&'static str, &'static str)] {
         match self {
-            Self::Continuous => &[("AfMode", "AfModeContinuous")],
-            Self::OnDemand => &[("AfMode", "AfModeAuto")],
+            Self::Continuous => &[
+                ("AfMetering", "AfMeteringAuto"),
+                ("AfMode", "AfModeContinuous"),
+            ],
+            Self::OnDemand => &[
+                ("AfMetering", "AfMeteringWindows"),
+                ("AfMode", "AfModeAuto"),
+            ],
             Self::Trigger => &[
+                ("AfMetering", "AfMeteringWindows"),
                 ("AfMode", "AfModeAuto"),
                 ("AfTrigger", "AfTriggerStart"),
             ],
+            Self::Manual => &[("AfMode", "AfModeManual")],
         }
     }
 }
