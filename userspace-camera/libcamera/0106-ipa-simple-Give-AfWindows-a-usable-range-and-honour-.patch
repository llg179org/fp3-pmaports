--- a/src/ipa/simple/algorithms/af.cpp
+++ b/src/ipa/simple/algorithms/af.cpp
@@ -167,11 +167,38 @@
 			    ControlValue(static_cast<int32_t>(controls::AfMeteringAuto)));
 
 	/*
-	 * One window, in pixels of the sensor's output. The bounds are filled
-	 * in at configure() time, once the output size is known.
+	 * Windows are given in pixels of the sensor's output - the frame the
+	 * software ISP produces - which is the space selectZones() measures
+	 * them against and the space an application computes a tap position
+	 * in. AfWindows is documented as being in ScalerCropMaximum pixels
+	 * instead, but the simple pipeline handler publishes no such property,
+	 * so there is nothing there for an application to read; stating the
+	 * space in the control's own maximum is what makes it usable.
+	 *
+	 * The bounds have to be stated here and not at configure() time: the
+	 * ControlInfoMap the camera advertises is taken once, when the software
+	 * ISP constructs the IPA, and is never read again. The size the IPA is
+	 * initialised with is the same one selectZones() uses, so the two agree
+	 * by construction.
+	 *
+	 * The minimum is one pixel rather than the empty rectangle, because a
+	 * window with no area selects no zone and is not something an
+	 * application can usefully ask for. The maximum, which is also the
+	 * default, is the whole frame - metering everything, as if no window
+	 * had been given.
+	 *
+	 * Without a size there is no coordinate space to name, so the control
+	 * is not offered at all rather than offered with bounds that mean
+	 * nothing.
 	 */
-	context.ctrlMap[&controls::AfWindows] =
-		ControlInfo(Rectangle(), Rectangle(), Rectangle());
+	const Size &output = context.sensorInfo.outputSize;
+	if (!output.isNull())
+		context.ctrlMap[&controls::AfWindows] =
+			ControlInfo(Rectangle(0, 0, 1, 1), Rectangle(output),
+				    Rectangle(output));
+	else
+		LOG(IPASoftAf, Warning)
+			<< "Output size unknown, focus windows unavailable";
 
