@@ -239,25 +280,28 @@
 
 /**
  * \brief Choose the focus zones the score is taken over
- * \param[in] windows The requested windows, empty for the whole frame
+ * \param[in] windows The requested windows
+ * \return True if the windows selected at least one zone, false otherwise
  *
- * A window is given in pixels of the sensor's output, which is what an
- * application can compute a tap position in. Any zone the window touches is
- * selected; a tap therefore always selects at least one zone, however small
- * the window it is turned into.
+ * A window is given in pixels of the sensor's active pixel array, the space
+ * init() advertises, and the zones divide the frame the software ISP produces.
+ * The two are related by the assumption that the stream covers the active area,
+ * so the mapping is proportional and needs no absolute size of its own. Any
+ * zone the window touches is selected; a tap therefore always selects at least
+ * one zone, however small the window it is turned into.
+ *
+ * Returning false leaves the caller to decide what a request that names no
+ * usable window should mean, rather than silently turning it into metering the
+ * whole frame - which is the one thing the caller did not ask for.
  */
-void Af::selectZones(IPAContext &context, Span<const Rectangle> windows)
+bool Af::selectZones(IPAContext &context, Span<const Rectangle> windows)
 {
-	if (windows.empty()) {
-		zones_.fill(true);
-		return;
-	}
+	if (windows.empty())
+		return false;
 
-	const Size &size = context.sensorInfo.outputSize;
-	if (size.isNull()) {
-		zones_.fill(true);
-		return;
-	}
+	const Size &size = context.sensorInfo.activeAreaSize;
+	if (size.isNull())
+		return false;
 
 	zones_.fill(false);
 
@@ -279,8 +323,34 @@
 				zones_[y * SwIspStats::kAfZonesX + x] = true;
 	}
 
-	if (std::none_of(zones_.begin(), zones_.end(), [](bool z) { return z; }))
+	return std::any_of(zones_.begin(), zones_.end(), [](bool z) { return z; });
+}
+
+/**
+ * \brief Recompute the metered zones from the metering mode and the windows
+ *
+ * The two controls that decide where the score is taken from arrive
+ * independently and in either order, so neither can be acted on where it is
+ * read. Both are kept, and the zones are derived from the pair.
+ */
+void Af::updateZones(IPAContext &context)
+{
+	if (metering_ == controls::AfMeteringAuto)
 		zones_.fill(true);
+	else if (!selectZones(context, windows_))
+		selectCentre();
+
+	/*
+	 * Where the score is taken from is otherwise invisible from outside the
+	 * IPA: the zones are internal, and a window that reached nothing looks
+	 * exactly like one that was never sent. Say how many zones ended up
+	 * metered, so that a request can be traced to an effect.
+	 */
+	LOG(IPASoftAf, Info)
+		<< "Metering " << std::count(zones_.begin(), zones_.end(), true)
+		<< " of " << zones_.size() << " zones ("
+		<< (metering_ == controls::AfMeteringAuto ? "auto" : "windows")
+		<< ", " << windows_.size() << " window(s) requested)";
 }
 
 /**
