+		if (value != metering_) {
+			metering_ = value;
+			remeter = true;
+		}
+	}
+
+	if (controls.contains(controls::AfWindows.id())) {
+		/*
+		 * ☠️ Read the raw value rather than get(controls::AfWindows).
+		 * AfWindows is declared as an array, but a request carrying a
+		 * single window may hold it as a scalar Rectangle - libcamera's
+		 * own cam tool sends it that way, and so will anything built on
+		 * ControlValue::set(Rectangle) - and reading a scalar through
+		 * the array accessor asserts and aborts the IPA process.
+		 * Measured 2026-08-16 the first time a window ever reached this
+		 * code: "Assertion failed: isArray_ (controls.h: get: 204)".
+		 */
+		const ControlValue &value = controls.get(controls::AfWindows.id());
+		std::vector<Rectangle> requested;
+
+		if (value.type() == ControlTypeRectangle) {
+			if (value.isArray()) {
+				const auto span = value.get<Span<const Rectangle>>();
+				requested.assign(span.begin(), span.end());
+			} else {
+				requested.push_back(value.get<Rectangle>());
+			}
+		}
+
+		if (requested != windows_) {
+			windows_ = std::move(requested);
+			remeter = true;
 		}
 	}
 
