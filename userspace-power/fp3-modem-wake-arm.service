# AI-generated (Claude Fable 5) under the direction of Lajosházi, László Gergely.
#
# Arm the modem SMD edge as a wakeup source, so an incoming call ends s2idle.
# The kernel-side knob ships in linux-fp3 r66 (qcom_smd wake-IRQ patch) and is
# deliberately disabled by default; this unit is the per-device opt-in.
# The remoteprocN index can move between boots, so the path globs on the
# 4080000 (MSS) parent and matches the edge by name, never by index.

[Unit]
Description=Arm the modem SMD edge as a wakeup source (incoming-call wake)
ConditionPathExists=/sys/devices/platform/soc@0/4080000.remoteproc

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'w=$(ls /sys/devices/platform/soc@0/4080000.remoteproc/remoteproc/*/*:smd-edge/power/wakeup 2>/dev/null | head -1); [ -n "$w" ] || { echo "no smd-edge wakeup knob (kernel older than r66?)"; exit 1; }; echo enabled > "$w" && echo "armed $w"'

[Install]
WantedBy=multi-user.target
